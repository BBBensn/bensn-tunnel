server {
    server_name stream.bensn.me;

    location / {
        proxy_pass http://10.10.0.2:30013;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Jellyfin braucht Websockets fuer Live-Updates
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Kein Buffering, damit Video-Streams nicht verzoegert werden
        proxy_buffering off;

        # Floating Link zur eigenen Wishlist/Bestandsliste (library.bensn.me)
        # injizieren - unabhaengig von Jellyfins eigenem CSS/JS, uebersteht
        # Jellyfin-App-Updates, da nichts an Jellyfins Dateien geaendert wird.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter '</body>' '<a href="https://library.bensn.me" target="_blank" rel="noopener" style="position:fixed;bottom:20px;right:20px;z-index:2147483647;display:flex;align-items:center;gap:8px;padding:10px 16px;background:#111113;border:1px solid rgba(255,255,255,0.15);border-radius:999px;color:#e8e6e0;font-family:DM Mono,monospace;font-size:12px;text-decoration:none;box-shadow:0 4px 20px rgba(0,0,0,0.4)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00A6FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21C12 21 4 14.5 4 8.75C4 5.75 6.5 3.5 9.25 3.5C10.86 3.5 12 4.5 12 4.5C12 4.5 13.14 3.5 14.75 3.5C17.5 3.5 20 5.75 20 8.75C20 14.5 12 21 12 21Z"></path></svg>Wishlist &amp; Bestand</a></body>';
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/stream.bensn.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/stream.bensn.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = stream.bensn.me) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name stream.bensn.me;
    return 404; # managed by Certbot


}
